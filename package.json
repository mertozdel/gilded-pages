{
  "name": "gilded-pages",
  "private": true,
  "version": "0.2.0",
  "description": "A pixel-art Jazz Age reading game: upload PDFs and read them with Roxy Lark.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/limelight": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "dexie": "^4.4.7",
    "easystarjs": "^0.4.4",
    "howler": "^2.2.4",
    "pdfjs-dist": "^6.4.299",
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/howler": "^2.2.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
